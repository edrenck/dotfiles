source "$HOME/.config/zsh/.zshenv"

HISTFILE="$HOME/.history"
HISTSIZE=10000
SAVEHIST=10000

# Register Homebrew executables and completions before loading plugins.
typeset -U path PATH fpath
if [[ -d /opt/homebrew/bin ]]; then
  path=(/opt/homebrew/bin $path)
elif [[ -d /usr/local/bin ]]; then
  path=(/usr/local/bin $path)
fi
path=("$HOME/.local/bin" $path)

_DOTFILES_BREW_PREFIX=''
if command -v brew >/dev/null 2>&1; then
  _DOTFILES_BREW_PREFIX="$(brew --prefix)"
  if [[ -d "$_DOTFILES_BREW_PREFIX/share/zsh/site-functions" ]]; then
    fpath=("$_DOTFILES_BREW_PREFIX/share/zsh/site-functions" $fpath)
  fi
fi

if command -v bat >/dev/null 2>&1; then
  export MANPAGER="bat -l man -p"
elif command -v batcat >/dev/null 2>&1; then
  export MANPAGER="batcat -l man -p"
fi
[[ -t 0 ]] && export GPG_TTY="$(tty)"
source "$HOME/.config/zsh/options.zsh"

# History-based suggestions stay predictable and visible on dark themes.
ZSH_AUTOSUGGEST_STRATEGY=(history)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=245'
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=200
ZSH_AUTOSUGGEST_USE_ASYNC=1
# Prevent deferred vi initialization from overwriting suggestion/history widgets.
ZVM_INIT_MODE=sourcing

_DOTFILES_COMPINIT_READY=0
_DOTFILES_HISTORY_READY=0

dotfiles_compinit() {
  (( _DOTFILES_COMPINIT_READY )) && return 0
  autoload -Uz compinit
  if command mkdir -p "$XDG_CACHE_HOME/zsh" 2>/dev/null; then
    compinit -i -d "$XDG_CACHE_HOME/zsh/zcompdump-$ZSH_VERSION" || return
  else
    compinit -i -D || return
  fi
  typeset -g _DOTFILES_COMPINIT_READY=1
}

dotfiles_history_init() {
  (( _DOTFILES_HISTORY_READY )) && return 0
  if [[ -t 0 ]] && command -v fzf >/dev/null 2>&1 && command -v fd >/dev/null 2>&1; then
    source "$HOME/.config/zsh/fzf.zsh"
  fi
  typeset -g _DOTFILES_HISTORY_READY=1
}

# Homebrew on macOS; bootstrap's Git installation on Linux.
antidote_file="$XDG_DATA_HOME/antidote/antidote.zsh"
if [[ -n "$_DOTFILES_BREW_PREFIX" && -r "$_DOTFILES_BREW_PREFIX/opt/antidote/share/antidote/antidote.zsh" ]]; then
  antidote_file="$_DOTFILES_BREW_PREFIX/opt/antidote/share/antidote/antidote.zsh"
fi
if [[ -r "$antidote_file" ]]; then
  source "$antidote_file"
  antidote load "$HOME/.zsh_plugins.txt" "$XDG_CACHE_HOME/zsh/antidote-plugins.zsh"
fi
unset antidote_file
# Keep a functional shell when the plugin manager is unavailable.
dotfiles_compinit
dotfiles_history_init

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi
if command -v thefuck >/dev/null 2>&1; then
  eval "$(thefuck --alias)"
fi
source "$HOME/.config/zsh/aliases.zsh"
