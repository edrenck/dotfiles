# ~/.config/zsh/zshrc — Main Zsh configuration loader (REVISED)
# Modular: Optimized for Antidote as a function-only plugin manager.
# This version guarantees static plugin loading and autoloads Antidote functions per best practices.
eval "$(/opt/homebrew/bin/brew shellenv)"
# 0. Zsh completions/init: Must come before plugins or plugin manager!
autoload -Uz compinit
compinit

# 1. Make Antidote functions available for 'bundle', 'update', etc. (ALWAYS BEFORE first use)
fpath=("/opt/homebrew/opt/antidote/share/antidote/functions" $fpath)
autoload -Uz antidote

# 1. Define plugin bundle and static loader path
ZSH_PLUGIN_LIST="$HOME/.config/zsh/plugins.zsh"
ZSH_PLUGIN_STATIC="$HOME/.zsh_plugins.zsh"

# 2. Rebuild plugin static loader if the list has changed (super-fast, idempotent)
if [[ ! $ZSH_PLUGIN_STATIC -nt $ZSH_PLUGIN_LIST ]]; then
  antidote bundle <"$ZSH_PLUGIN_LIST" >! "$ZSH_PLUGIN_STATIC"
fi

# 3. Source the fast loaded plugin file (all plugins loaded from cache)
source "$ZSH_PLUGIN_STATIC"

# 4. Remaining modular configs (safe to load in any order after plugins)
source "$HOME/.config/zsh/env.zsh"
source "$HOME/.config/zsh/aliases.zsh"
source "$HOME/.config/zsh/functions.zsh"
source "$HOME/.config/zsh/theme.zsh"
source "$HOME/.config/zsh/completions.zsh"

if [[ "$USER" = "erenc" ]]; then
  source "$HOME/.config/zsh/proxy.zsh"
fi

# Inline docs in every module per original structure

# Ensure zoxide hooks completions to all relevant aliases (cd/z/j) AFTER all aliases/plugins have loaded
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init zsh)"
fi

# Manually load fzf-tab after ALL plugins and everything else (per robust integration)
if [ -f "$HOME/.cache/antidote/https-COLON--SLASH--SLASH-github.com-SLASH-Aloxaf-SLASH-fzf-tab/fzf-tab.plugin.zsh" ]; then
  source "$HOME/.cache/antidote/https-COLON--SLASH--SLASH-github.com-SLASH-Aloxaf-SLASH-fzf-tab/fzf-tab.plugin.zsh"
fi
