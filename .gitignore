# yadm's work tree is HOME: only deliberately managed files are eligible.
/*
!/.gitignore
!/README.md
!/.aerospace.toml
!/.zshrc
!/.zsh_plugins.txt
!/.config/
/.config/*
!/.config/borders/
!/.config/btop/
!/.config/ghostty/
!/.config/lazydocker/
!/.config/lazygit/
!/.config/nvim/
!/.config/opencode/
!/.config/starship.toml
!/.config/yadm/
!/.config/zed/
!/.config/zsh/

# Credential stores, generated state, and local overrides stay on each machine.
/.config/anytype/
/.config/github-copilot/
/.config/zed/prompts/
/.config/opencode/node_modules/
/.config/opencode/package-lock.json
/.config/yadm/config
/.config/yadm/encrypt
/.config/yadm/archive
.zshrc.local
*.local.zsh
.env
.env.*
!.env.example
.DS_Store
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.mdb
*.log
*.pem
*.key
*.p12
*.pfx
api-key
api_key
credentials.json
auth.json
auth.yaml
auth.yml
*history*

# Additional credential locations (also covered by the home allowlist).
/.ssh/
/.gnupg/
/.aws/
/.kube/
/.docker/config.json
/.config/gh/
/.local/share/opencode/auth.json
/.codex/auth.json
/.codex/sessions/
/.claude/
/.openclaw/
/.hermes/

# Common credential filenames, including inside allowed configuration folders.
.netrc
.npmrc
.pypirc
.git-credentials
.envrc
.envrc.*
!.envrc.example
credentials.*
secrets.*
*.secret
*.secrets
id_rsa
id_ed25519
id_ecdsa
id_dsa
